    {
        "name":  "elementor-mcp-search-images",
        "description":  "Searches Openverse (WordPress.org) for Creative Commons licensed images. Returns image URLs, thumbnails, licensing info, and attribution. Use the returned URLs with sideload-image or add-stock-image.",
        "inputSchema":  {
                            "type":  "object",
                            "properties":  {
                                               "query":  {
                                                             "type":  "string",
                                                             "description":  "Search keywords (e.g. \"mountain landscape\", \"modern office\")."
                                                         },
                                               "page":  {
                                                            "type":  "integer",
                                                            "description":  "Page number. Default: 1."
                                                        },
                                               "page_size":  {
                                                                 "type":  "integer",
                                                                 "description":  "Results per page (1-20). Default: 5."
                                                             },
                                               "license":  {
                                                               "type":  "string",
                                                               "enum":  [
                                                                            "by",
                                                                            "by-sa",
                                                                            "by-nc",
                                                                            "cc0",
                                                                            "pdm"
                                                                        ],
                                                               "description":  "Filter by Creative Commons license type."
                                                           },
                                               "source":  {
                                                              "type":  "string",
                                                              "description":  "Filter by source (e.g. \"flickr\", \"wikimedia\", \"wordpress\")."
                                                          },
                                               "aspect_ratio":  {
                                                                    "type":  "string",
                                                                    "enum":  [
                                                                                 "tall",
                                                                                 "wide",
                                                                                 "square"
                                                                             ],
                                                                    "description":  "Filter by aspect ratio. Use \"wide\" for landscape images (recommended for hero banners, cards, and most page layouts). Use \"tall\" for portrait/sidebar images. Use \"square\" for avatars and thumbnails."
                                                                },
                                               "size":  {
                                                            "type":  "string",
                                                            "enum":  [
                                                                         "small",
                                                                         "medium",
                                                                         "large"
                                                                     ],
                                                            "description":  "Filter by image size."
                                                        },
                                               "category":  {
                                                                "type":  "string",
                                                                "enum":  [
                                                                             "photograph",
                                                                             "illustration",
                                                                             "digitized_artwork"
                                                                         ],
                                                                "description":  "Filter by image category."
                                                            }
                                           },
                            "required":  [
                                             "query"
                                         ]
                        }
    },
    {
        "name":  "elementor-mcp-sideload-image",
        "description":  "Downloads an external image URL into the WordPress Media Library and returns the local attachment ID and URL. Use this after search-images to import a chosen image.",
        "inputSchema":  {
                            "type":  "object",
                            "properties":  {
                                               "url":  {
                                                           "type":  "string",
                                                           "description":  "The external image URL to download."
                                                       },
                                               "title":  {
                                                             "type":  "string",
                                                             "description":  "Attachment title. Falls back to the filename."
                                                         },
                                               "alt_text":  {
                                                                "type":  "string",
                                                                "description":  "Alt text for the image."
                                                            },
                                               "caption":  {
                                                               "type":  "string",
                                                               "description":  "Image caption."
                                                           },
                                               "attribution":  {
                                                                   "type":  "string",
                                                                   "description":  "Attribution text for Creative Commons images. Stored as the attachment caption/excerpt."
                                                               }
                                           },
                            "required":  [
                                             "url"
                                         ]
                        }
    },
    {
        "name":  "elementor-mcp-add-stock-image",
        "description":  "Searches Openverse for an image, downloads it to the Media Library, and adds it as an image widget to the page — all in one step. Defaults to landscape (wide) images for consistent layouts. Combines search-images + sideload-image + add-image.",
        "inputSchema":  {
                            "type":  "object",
                            "properties":  {
                                               "post_id":  {
                                                               "type":  "integer",
                                                               "description":  "The post/page ID."
                                                           },
                                               "parent_id":  {
                                                                 "type":  "string",
                                                                 "description":  "Parent container element ID."
                                                             },
                                               "query":  {
                                                             "type":  "string",
                                                             "description":  "Image search keywords (e.g. \"hero banner technology\", \"team photo office\")."
                                                         },
                                               "index":  {
                                                             "type":  "integer",
                                                             "description":  "Which search result to use (0 = best match). Default: 0."
                                                         },
                                               "position":  {
                                                                "type":  "integer",
                                                                "description":  "Insert position within parent. -1 = append (default)."
                                                            },
                                               "image_size":  {
                                                                  "type":  "string",
                                                                  "enum":  [
                                                                               "thumbnail",
                                                                               "medium",
                                                                               "medium_large",
                                                                               "large",
                                                                               "full"
                                                                           ],
                                                                  "description":  "Image size preset. Default: full."
                                                              },
                                               "align":  {
                                                             "type":  "string",
                                                             "enum":  [
                                                                          "left",
                                                                          "center",
                                                                          "right"
                                                                      ],
                                                             "description":  "Image alignment."
                                                         },
                                               "caption":  {
                                                               "type":  "string",
                                                               "description":  "Caption override. Defaults to Openverse attribution."
                                                           },
                                               "aspect_ratio":  {
                                                                    "type":  "string",
                                                                    "enum":  [
                                                                                 "wide",
                                                                                 "tall",
                                                                                 "square",
                                                                                 "any"
                                                                             ],
                                                                    "description":  "Image aspect ratio filter. Default: wide (landscape). Use \"wide\" for hero banners and card images, \"tall\" for sidebar/portrait, \"square\" for thumbnails, \"any\" for no filter."
                                                                },
                                               "alt_text":  {
                                                                "type":  "string",
                                                                "description":  "Alt text override. Defaults to the image title."
                                                            },
                                               "link_to":  {
                                                               "type":  "string",
                                                               "enum":  [
                                                                            "none",
                                                                            "file",
                                                                            "custom"
                                                                        ],
                                                               "description":  "Link behavior. Default: none."
                                                           }
                                           },
                            "required":  [
                                             "post_id",
                                             "parent_id",
                                             "query"
                                         ]
                        }
    },
    {
        "name":  "elementor-mcp-list-media",
        "description":  "Lists and searches images already in the WordPress Media Library. Use this to find a site\u0027s own uploaded photos (e.g. a client\u0027s product or job-site images) before reaching for Openverse stock. The optional \"search\" matches the title, alt text, caption, and description. Returns attachment IDs and URLs you can pass straight to add-image / add-widget.",
        "inputSchema":  {
                            "type":  "object",
                            "properties":  {
                                               "search":  {
                                                              "type":  "string",
                                                              "description":  "Keyword to match against the attachment title, alt text, caption, and description. Omit to list everything."
                                                          },
                                               "mime_type":  {
                                                                 "type":  "string",
                                                                 "description":  "MIME type filter. Accepts a top-level type (\"image\") or a specific type (\"image/jpeg\", \"image/png\"). Use \"any\" for all media types. Default: image."
                                                             },
                                               "page":  {
                                                            "type":  "integer",
                                                            "description":  "Page number (1-based). Default: 1."
                                                        },
                                               "per_page":  {
                                                                "type":  "integer",
                                                                "description":  "Results per page (1-100). Default: 20."
                                                            },
                                               "orderby":  {
                                                               "type":  "string",
                                                               "enum":  [
                                                                            "date",
                                                                            "title"
                                                                        ],
                                                               "description":  "Sort field. Default: date (newest first)."
                                                           },
                                               "order":  {
                                                             "type":  "string",
                                                             "enum":  [
                                                                          "desc",
                                                                          "asc"
                                                                      ],
                                                             "description":  "Sort direction. Default: desc."
                                                         }
                                           }
                        }
    },
    {
        "name":  "elementor-mcp-upload-svg-icon",
        "description":  "Uploads an SVG icon to the WordPress Media Library and returns an Elementor icon object ready to use with any widget that accepts icons (icon, icon-box, button, etc.). Accepts either an external SVG URL or raw SVG markup. The returned icon object has the format: { \"value\": { \"id\": 123, \"url\": \"...\" }, \"library\": \"svg\" }. Use this value for the selected_icon setting in icon/icon-box widgets, or the selected_icon setting in button widgets.",
        "inputSchema":  {
                            "type":  "object",
                            "properties":  {
                                               "svg_url":  {
                                                               "type":  "string",
                                                               "description":  "External URL to an SVG file to download and import. Use this OR svg_content, not both."
                                                           },
                                               "svg_content":  {
                                                                   "type":  "string",
                                                                   "description":  "Raw SVG markup string (e.g. \"\u003csvg viewBox=\u00270 0 24 24\u0027\u003e\u003cpath d=\u0027M12 ...\u0027/\u003e\u003c/svg\u003e\"). Use this OR svg_url, not both."
                                                               },
                                               "title":  {
                                                             "type":  "string",
                                                             "description":  "Title for the SVG in the Media Library. Falls back to filename or \"Custom SVG Icon\"."
                                                         }
                                           }
                        }
    },
