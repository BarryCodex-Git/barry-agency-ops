[
    {
        "name":  "elementor-mcp-add-image",
        "description":  "Adds an image widget. Supports width, max-width, opacity, border, border-radius, box shadow, CSS filters (brightness, contrast, saturation, hue), and hover effects. Accepts responsive suffixes and advanced controls. All other settings pass through; get-widget-schema for the full list.",
        "inputSchema":  {
                            "type":  "object",
                            "properties":  {
                                               "post_id":  {
                                                               "type":  "integer",
                                                               "description":  "Page ID."
                                                           },
                                               "parent_id":  {
                                                                 "type":  "string",
                                                                 "description":  "Parent container ID."
                                                             },
                                               "position":  {
                                                                "type":  "integer",
                                                                "description":  "Insert position; -1 appends."
                                                            },
                                               "image":  {
                                                             "type":  "object",
                                                             "description":  "Image object with url (required) and optional id."
                                                         },
                                               "image_size":  {
                                                                  "type":  "string",
                                                                  "enum":  [
                                                                               "thumbnail",
                                                                               "medium",
                                                                               "medium_large",
                                                                               "large",
                                                                               "full"
                                                                           ],
                                                                  "description":  "Image size preset."
                                                              },
                                               "align":  {
                                                             "type":  "string",
                                                             "enum":  [
                                                                          "left",
                                                                          "center",
                                                                          "right"
                                                                      ],
                                                             "description":  "Image alignment. Responsive: align_tablet, align_mobile."
                                                         },
                                               "caption_source":  {
                                                                      "type":  "string",
                                                                      "enum":  [
                                                                                   "none",
                                                                                   "attachment",
                                                                                   "custom"
                                                                               ],
                                                                      "description":  "Caption source."
                                                                  },
                                               "caption":  {
                                                               "type":  "string",
                                                               "description":  "Custom caption text."
                                                           }
                                           },
                            "required":  [
                                             "post_id",
                                             "parent_id",
                                             "image"
                                         ]
                        }
    },
